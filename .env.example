TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults point at the live Veydrift deployment on Base mainnet.
RPC_URL=https://mainnet.base.org
VEYDRIFT_API_URL=https://api.veydrift.com
VEYDRIFT_CONTRACT_ADDRESS=0xf397910F005151b09644228573a4353818D3755d

# Optional reliability tuning.
CONFIRMATIONS=2
POLL_INTERVAL_MS=4000
BLOCK_BATCH_SIZE=2000
STATE_FILE=.state/cursor.json

# ETH/VEYDRIFT buys (BUY_CHAT_ID= with an empty value turns them off).
BUY_CHAT_ID=@veydriftdotcom
BUY_POOL_ID=0xa48cdc0e5f4612b2400ea20aad0df45cdd3f51e1f7584d318239d217cef45c51
BUY_MIN_USD=0
BUY_STATE_FILE=.state/buys.json
